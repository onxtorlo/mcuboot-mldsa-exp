   MLD_FREE(mu, uint8_t, MLDSA_CRHBYTES, context);
   MLD_FREE(rho, uint8_t, MLDSA_SEEDBYTES, context);
   MLD_FREE(buf, uint8_t, (MLDSA_K * MLDSA_POLYW1_PACKEDBYTES), context);
+  BOOT_MEASURE_D_STOP(BOOT_MEASURE_D_MLD_VERIFY);
   return ret;
 }
 
