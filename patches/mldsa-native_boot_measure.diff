diff --git a/mldsa/src/boot_measure_hooks.h b/mldsa/src/boot_measure_hooks.h
new file mode 100644
index 0000000..b17f921
--- /dev/null
+++ b/mldsa/src/boot_measure_hooks.h
@@ -0,0 +1,26 @@
+/* boot_measure_hooks.h - cycle counting hooks for MCUboot measurements */
+
+/*
+ * Inside an MCUboot build with boot stage timing enabled these map to
+ * bootutil/boot_measure.h (BOOT_MEASURE_D_* steps, BOOT_MEASURE_P_*
+ * primitives); everywhere else they are empty.
+ */
+
+#ifndef MLD_BOOT_MEASURE_HOOKS_H
+#define MLD_BOOT_MEASURE_HOOKS_H
+
+#if defined(CONFIG_BOOT_MEASURE_TIMING) && defined(__has_include)
+#if __has_include("bootutil/boot_measure.h")
+#include "bootutil/boot_measure.h"
+#define MLD_BOOT_MEASURE_HOOKS_ACTIVE
+#endif
+#endif
+
+#if !defined(MLD_BOOT_MEASURE_HOOKS_ACTIVE)
+#define BOOT_MEASURE_D_START(id) ((void)0)
+#define BOOT_MEASURE_D_STOP(id) ((void)0)
+#define BOOT_MEASURE_P_START(id) ((void)0)
+#define BOOT_MEASURE_P_STOP(id) ((void)0)
+#endif
+
+#endif /* !MLD_BOOT_MEASURE_HOOKS_H */
diff --git a/mldsa/src/fips202/keccakf1600.c b/mldsa/src/fips202/keccakf1600.c
index e59120c..77529d6 100644
--- a/mldsa/src/fips202/keccakf1600.c
+++ b/mldsa/src/fips202/keccakf1600.c
@@ -31,6 +31,7 @@
 #include <stdint.h>
 
 #include "keccakf1600.h"
+#include "../boot_measure_hooks.h"
 #if !defined(MLD_CONFIG_MULTILEVEL_NO_SHARED)
 
 #define MLD_KECCAK_NROUNDS 24
@@ -406,13 +407,16 @@ static void mld_keccakf1600_permute_c(uint64_t *state)
 
 void mld_keccakf1600_permute(uint64_t *state)
 {
+  BOOT_MEASURE_P_START(BOOT_MEASURE_P_MLD_KECCAK);
 #if defined(MLD_USE_FIPS202_X1_NATIVE)
   if (mld_keccak_f1600_x1_native(state) == MLD_NATIVE_FUNC_SUCCESS)
   {
+    BOOT_MEASURE_P_STOP(BOOT_MEASURE_P_MLD_KECCAK);
     return;
   }
 #endif /* MLD_USE_FIPS202_X1_NATIVE */
   mld_keccakf1600_permute_c(state);
+  BOOT_MEASURE_P_STOP(BOOT_MEASURE_P_MLD_KECCAK);
 }
 
 #else /* !MLD_CONFIG_MULTILEVEL_NO_SHARED */
