+/* boot_measure_hooks.h - cycle counting hooks for MCUboot measurements */
+
+/*
+ * Inside an MCUboot build with boot stage timing enabled these map to
+ * bootutil/boot_measure.h (BOOT_MEASURE_D_* steps, BOOT_MEASURE_P_*
+ * primitives); everywhere else they are empty.
+ */
+
+#ifndef TF_PSA_CRYPTO_BOOT_MEASURE_HOOKS_H
+#define TF_PSA_CRYPTO_BOOT_MEASURE_HOOKS_H
+
+#if defined(CONFIG_BOOT_MEASURE_TIMING) && defined(__has_include)
+#if __has_include("bootutil/boot_measure.h")
+#include "bootutil/boot_measure.h"
+#define BOOT_MEASURE_HOOKS_ACTIVE
+#endif
+#endif
+
+#if !defined(BOOT_MEASURE_HOOKS_ACTIVE)
+#define BOOT_MEASURE_D_START(id) ((void)0)
+#define BOOT_MEASURE_D_STOP(id)  ((void)0)
+#define BOOT_MEASURE_P_START(id) ((void)0)
+#define BOOT_MEASURE_P_STOP(id)  ((void)0)
+#endif
+
+#endif /* TF_PSA_CRYPTO_BOOT_MEASURE_HOOKS_H */
